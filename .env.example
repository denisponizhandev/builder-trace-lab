GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

SIMULATION_DELAY_MS=
SIMULATION_QUEUE_CAPACITY=
RESULT_QUEUE_CAPACITY=

ADMISSION_POLICY=unbounded|wait|reject

RUST_LOG=info