POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_URL=postgresql://USER:PASSWORD@localhost:PORT/DB

RPC_WS_URL=
HTTP_BIND=0.0.0.0:8080

# Observability (docker compose). Prometheus scrapes host.docker.internal:8080 — keep HTTP_BIND port in sync.
PROMETHEUS_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Demo backpressure profile (~10 jobs/s per worker at 100ms sleep; queue fills in ~3s at 50/s ingress)
SIMULATION_DELAY_MS=100
SIMULATION_QUEUE_CAPACITY=32
RESULT_QUEUE_CAPACITY=64

ADMISSION_POLICY=unbounded|wait|reject

RUST_LOG=info